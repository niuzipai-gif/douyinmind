# ===== 必填 =====
# DeepSeek API Key（LLM 对话）
DEEPSEEK_API_KEY=sk-your-deepseek-key

# DashScope API Key（ASR 语音转写 + Embedding 向量化）
DASHSCOPE_API_KEY=sk-your-dashscope-key

# 公开部署时建议设置；前端会在首次打开时要求输入
APP_ACCESS_TOKEN=

# 本机登录助手上传登录态到 Render 时使用；不要提交真实值
DOUYIN_BRIDGE_TOKEN=

# 允许访问后端 API 的前端来源，多个来源用英文逗号分隔
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== LLM 配置 =====
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# ===== Embedding 配置 =====
EMBEDDING_MODEL=text-embedding-v4

# ===== ASR 配置 =====
# DashScope 语音识别模型
ASR_MODEL=paraformer-v2

# ===== 检索参数（保持默认即可）=====
RETRIEVAL_TOP_K=8
RETRIEVAL_MMR_FETCH_K=32
RETRIEVAL_MMR_LAMBDA=0.55
RAG_CONTEXT_COUNT=5
RAG_PROMPT_MAX_CONTEXT_CHARS=8000

# ===== 切块参数 =====
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ===== 对话 =====
CHAT_HISTORY_WINDOW=6
CHAT_MAX_CONTENT_CHARS=2000

# ===== 数据库 =====
DATABASE_URL=sqlite:///app/storage/douyinrag.db
CHROMA_PERSIST_DIR=app/storage/chroma

# ===== 音频缓存 =====
AUDIO_CACHE_DIR=app/storage/audio_cache
